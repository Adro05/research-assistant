# Copy this file to .env for local development.
# Do not commit a real .env file — it is excluded via .gitignore.

# General application settings
APP_NAME="Research Assistant"
ENVIRONMENT=development
DEBUG=true

# API server settings
API_HOST=0.0.0.0
API_PORT=8000

# Database settings (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/research_assistant

# Filesystem locations for document data
DATA_DIR=data
UPLOADS_DIR=data/uploads
PROCESSED_DIR=data/processed
VECTOR_STORES_DIR=data/vector_stores